{
  "name": "@show-me-the-law/db",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.ts",
  "scripts": {
    "db:push": "dotenv -e ../../.env -- drizzle-kit push",
    "db:generate": "dotenv -e ../../.env -- drizzle-kit generate",
    "db:migrate": "dotenv -e ../../.env -- drizzle-kit migrate",
    "db:seed": "dotenv -e ../../.env -- tsx src/seed.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@show-me-the-law/typescript-config": "workspace:*",
    "@types/node": "^24.1.0",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.13",
    "typescript": "7.0.2"
  }
}
