# Read by docker-compose.yaml to configure the Postgres container. Must stay
# in sync with the user/password/db embedded in DATABASE_URL below.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=show_me_the_law

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/show_me_the_law
# Valkey speaks the Redis wire protocol — ioredis/BullMQ connect with redis://, this isn't a typo
REDIS_URL=redis://localhost:6380
PORT=3000
